# Copy to .env and fill in. Never commit .env.

# production | development. In production the app refuses to start with
# DEV_LOGIN on, the default session secret, or Azure unconfigured.
ENV=development

DATABASE_URL=postgresql+psycopg://pipeline:pipeline@localhost:5433/pipeline

# Long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
SESSION_SECRET=change-me
# Set true when served over HTTPS (cookie gets the Secure flag)
COOKIE_SECURE=false
# Public URL users type in the browser; the Azure redirect URI is BASE_URL/auth/callback
BASE_URL=http://localhost:8000
# Used to stamp "today" on new leads and activity
APP_TIMEZONE=Asia/Kolkata

# --- Azure Entra ID (single tenant) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Who gets the Manager role. Everyone else who signs in is a Rep.
# Comma-separated emails and/or an Entra group object id (needs the "groups"
# claim enabled on the app registration's token configuration).
MANAGER_EMAILS=
MANAGER_GROUP_ID=

# Lets scripts/push_leads.py load a Lead Desk export. Leave empty to disable.
# 32+ random characters; give it only to whoever runs the import.
INGEST_API_KEY=

# Optional: serve a static front-end build from this process instead of a proxy.
FRONTEND_DIR=
# Only for a client that builds HTML from strings (the old single-page version).
REJECT_MARKUP=false

# Local development only: lets you sign in as a pick-list of test users
# without Azure. Must be false in production.
DEV_LOGIN=false
