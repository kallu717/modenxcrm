# Copy to deploy/.env (git-ignored). Used by docker-compose.yml.
POSTGRES_PASSWORD=
SESSION_SECRET=            # 32+ random characters
BASE_URL=http://localhost:8080
ENV=development
COOKIE_SECURE=false

# Azure Entra ID (leave blank to use DEV_LOGIN locally)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ADMIN_EMAILS=              # your work email; always Admin. Admins give everyone else a role in Settings.

INGEST_API_KEY=            # 32+ random characters, or empty to disable
DEV_LOGIN=true             # local only; the API refuses to start in production with this on
